generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum RelationshipStrength {
  COLD
  WARM
  STRONG
}

enum TouchpointType {
  EMAIL
  LINKEDIN
  CALL
  MEETING
  REFERRAL_ASK
  NOTE
}

model Company {
  id        String   @id @default(cuid())
  userId    String
  name      String
  track     String   @default("jobs")
  website   String?
  location  String?
  industry  String?
  source    String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunities Opportunity[]
  contacts      Contact[]

  @@index([userId, track])
}

model Opportunity {
  id             String    @id @default(cuid())
  userId         String
  title          String
  track          String    @default("jobs")
  companyId      String?
  stage          String    @default("SAVED")
  // Solo relevante en tracks con entrega (freelance): distingue un proyecto
  // PROPIO (lo trabajás vos, Konexo registra avances) de uno DE CLIENTE.
  // Cambia cómo lo trata la IA: propio = gestión interna, cliente = también outreach.
  kind           String    @default("client") // client | own
  // Personalización visual de un proyecto PROPIO (kind = own): color de acento
  // (clave de la paleta en lib/appearance.ts) y un emoji. Nulos = look por
  // defecto. No aplican a proyectos de cliente.
  accentColor    String?
  accentEmoji    String?
  url            String?
  location       String?
  salaryRange    String?
  value          Float?
  jobDescription String?
  priority       Priority  @default(MEDIUM)
  appliedAt      DateTime?
  nextFollowUpAt DateTime?
  cvVersionId    String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  cvVersion    CVVersion?    @relation(fields: [cvVersionId], references: [id], onDelete: SetNull)
  touchpoints  Touchpoint[]
  projectNotes ProjectNote[]
  projectTasks ProjectTask[]

  @@index([userId, track])
  @@index([userId, track, stage])
}

model Contact {
  id                   String               @id @default(cuid())
  userId               String
  name                 String
  track                String               @default("jobs")
  role                 String?
  companyId            String?
  email                String?
  linkedinUrl          String?
  phone                String?
  relationshipStrength RelationshipStrength @default(COLD)
  nextFollowUpAt       DateTime?
  notes                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  touchpoints Touchpoint[]

  @@index([userId, track])
}

model Touchpoint {
  id            String         @id @default(cuid())
  userId        String
  type          TouchpointType
  note          String?
  occurredAt    DateTime       @default(now())
  contactId     String?
  opportunityId String?
  createdAt     DateTime       @default(now())

  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model CVVersion {
  id        String   @id @default(cuid())
  userId    String
  label     String
  fileName  String?
  content   String?
  notes     String?
  createdAt DateTime @default(now())

  opportunities Opportunity[]

  @@index([userId])
}

// Captura de emails de la landing (lead magnet / señal de demanda). No está
// scopeada por usuario: son leads anónimos previos al signup.
model WaitlistSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String? // de dónde vino (ej. "hero", "cta-final")
  createdAt DateTime @default(now())
}

model Setting {
  id     String @id @default(cuid())
  userId String
  key    String
  value  String

  @@unique([userId, key])
  @@index([userId])
}

// Seguimiento de EJECUCIÓN del proyecto (separado del embudo comercial).
// Solo aplica a tracks con fase de entrega (hoy: freelance). La bitácora es un
// stream de ideas/avances; las tareas son un checklist de hitos.
model ProjectNote {
  id            String   @id @default(cuid())
  userId        String
  opportunityId String
  kind          String   @default("avance") // idea | avance
  body          String
  createdAt     DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([opportunityId, createdAt])
}

model ProjectTask {
  id            String   @id @default(cuid())
  userId        String
  opportunityId String
  title         String
  done          Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([opportunityId, order])
}

// Progreso de onboarding gamificado ("Misiones/Batallas") + créditos del
// usuario. Una fila por usuario (userId de Clerk, sin modelo User propio: ver
// [[fundeable-pivot]]). Cada misión se guarda como timestamp nullable —misma
// convención que `activatedAt`/`appliedAt`: null = pendiente, fecha = cuándo se
// completó—. La lógica idempotente (otorgar créditos una sola vez) vive en
// lib/onboarding.ts; los disparadores se enganchan en las actions de cada
// entidad y/o vía el hook useOnboarding.
model UserProgress {
  id     String @id @default(cuid())
  userId String @unique

  // Misiones de onboarding (null = pendiente, fecha = completada)
  firstSightingAt    DateTime? // "Primer Avistamiento" — 1ª empresa/cuenta
  establishContactAt DateTime? // "Establecer Contacto" — 1er contacto
  launchAttackAt     DateTime? // "Lanzar Ataque" — 1er touchpoint/petición
  setRadarAt         DateTime? // "Fijar Radar" — 1er follow-up configurado

  credits Int @default(0) // créditos acumulados por completar misiones

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Contador de uso de IA por usuario y día (auditoría / Tarea 3). Rate-limita el
// proveedor DEFAULT (la key del dueño) para que un usuario no queme la cuota
// compartida. Una fila por (userId, día UTC). Solo se cuenta cuando el usuario
// usa la key compartida; con su propia key configurada no se toca esta tabla
// (uso ilimitado). El contador simplemente crece; no hace falta limpiar filas
// viejas (son chicas), pero se pueden purgar por día si se quisiera.
model AiUsage {
  id     String @id @default(cuid())
  userId String
  day    String // "YYYY-MM-DD" en UTC
  count  Int    @default(0)

  @@unique([userId, day])
  @@index([userId])
}

// Etapas del embudo, editables por el usuario. Cada track tiene su set.
// Se siembran desde los presets de lib/tracks.ts la primera vez que se leen.
model PipelineStage {
  id          String   @id @default(cuid())
  userId      String
  track       String
  key         String
  label       String
  order       Int
  type        String   @default("open") // open | won | lost
  probability Int      @default(0) // 0-100, para el forecast ponderado
  createdAt   DateTime @default(now())

  @@unique([userId, track, key])
  @@index([userId, track, order])
}
