generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum RelationshipStrength {
  COLD
  WARM
  STRONG
}

enum TouchpointType {
  EMAIL
  LINKEDIN
  CALL
  MEETING
  REFERRAL_ASK
  NOTE
}

model Company {
  id        String   @id @default(cuid())
  userId    String
  name      String
  track     String   @default("jobs")
  website   String?
  location  String?
  industry  String?
  source    String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunities Opportunity[]
  contacts      Contact[]

  @@index([userId, track])
}

model Opportunity {
  id             String    @id @default(cuid())
  userId         String
  title          String
  track          String    @default("jobs")
  companyId      String?
  stage          String    @default("SAVED")
  url            String?
  location       String?
  salaryRange    String?
  value          Float?
  jobDescription String?
  priority       Priority  @default(MEDIUM)
  appliedAt      DateTime?
  nextFollowUpAt DateTime?
  cvVersionId    String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  cvVersion   CVVersion?   @relation(fields: [cvVersionId], references: [id], onDelete: SetNull)
  touchpoints Touchpoint[]

  @@index([userId, track])
  @@index([userId, track, stage])
}

model Contact {
  id                   String               @id @default(cuid())
  userId               String
  name                 String
  track                String               @default("jobs")
  role                 String?
  companyId            String?
  email                String?
  linkedinUrl          String?
  phone                String?
  relationshipStrength RelationshipStrength @default(COLD)
  nextFollowUpAt       DateTime?
  notes                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  touchpoints Touchpoint[]

  @@index([userId, track])
}

model Touchpoint {
  id            String         @id @default(cuid())
  userId        String
  type          TouchpointType
  note          String?
  occurredAt    DateTime       @default(now())
  contactId     String?
  opportunityId String?
  createdAt     DateTime       @default(now())

  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model CVVersion {
  id        String   @id @default(cuid())
  userId    String
  label     String
  fileName  String?
  content   String?
  notes     String?
  createdAt DateTime @default(now())

  opportunities Opportunity[]

  @@index([userId])
}

// Captura de emails de la landing (lead magnet / señal de demanda). No está
// scopeada por usuario: son leads anónimos previos al signup.
model WaitlistSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String? // de dónde vino (ej. "hero", "cta-final")
  createdAt DateTime @default(now())
}

model Setting {
  id     String @id @default(cuid())
  userId String
  key    String
  value  String

  @@unique([userId, key])
  @@index([userId])
}

// Etapas del embudo, editables por el usuario. Cada track tiene su set.
// Se siembran desde los presets de lib/tracks.ts la primera vez que se leen.
model PipelineStage {
  id          String   @id @default(cuid())
  userId      String
  track       String
  key         String
  label       String
  order       Int
  type        String   @default("open") // open | won | lost
  probability Int      @default(0) // 0-100, para el forecast ponderado
  createdAt   DateTime @default(now())

  @@unique([userId, track, key])
  @@index([userId, track, order])
}
