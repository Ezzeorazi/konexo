# Ruta local de la base SQLite (no es un secreto, pero cada máquina tiene la suya)
DATABASE_URL="file:./prisma/dev.db"

# URL pública del sitio. Se usa como metadataBase (Open Graph, canonical).
# Producción: https://konexo.site. En previews podés apuntar a la *.vercel.app.
NEXT_PUBLIC_SITE_URL="https://konexo.site"

# --- Auth con Clerk (opcional en dev) ---
# Sin estas keys, la app corre con un usuario-dev local (ver lib/auth.ts).
# Apenas las cargás, se activa el login real y el aislamiento por usuario.
# Conseguilas en https://dashboard.clerk.com → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Rutas de login (ya implementadas en /sign-in y /sign-up)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# userId del usuario-dev cuando Clerk está apagado (opcional)
# DEV_USER_ID="dev-user"

# --- IA para todos (opcional pero recomendado) ---
# Con esto la app viene con IA lista para cualquier usuario sin que configure
# nada (fallback del lado del servidor). Cada usuario igual puede overridear su
# proveedor/key en Configuración. Groq tiene capa gratuita: creá la key en
# console.groq.com → API Keys (sin tarjeta).
GROQ_API_KEY=""
# Opcionales para cambiar el default compartido (por defecto: groq + su modelo):
# AI_DEFAULT_PROVIDER="groq"
# AI_DEFAULT_MODEL="llama-3.3-70b-versatile"
# AI_DEFAULT_API_KEY=""   # alternativa a GROQ_API_KEY si el default no es Groq

# --- Analítica de producto (PostHog, opcional) ---
# Sin estas keys, la analítica no se emite (no rompe nada). Conseguilas en
# posthog.com → Project Settings. La phc_ es pública (va en el browser).
# Server-side (eventos de activación, fiables):
POSTHOG_API_KEY=""
POSTHOG_HOST="https://us.i.posthog.com"
# Client-side (pageviews → retención):
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- App Android / TWA (Play Store, opcional) ---
# Verifican que la app de la Play Store es dueña de konexo.site (Digital Asset
# Links → /.well-known/assetlinks.json). El fingerprint sale al firmar el .aab
# (PWABuilder/Bubblewrap) o en Play Console → Integridad de la app → App signing.
# Sin fingerprint, assetlinks.json devuelve [] (no rompe la web).
# ANDROID_CERT_FINGERPRINT="AB:CD:12:...:EF"   # SHA-256, mayúsculas, separado por ":"
# ANDROID_PACKAGE_NAME="site.konexo.twa"        # debe coincidir con el de PWABuilder
